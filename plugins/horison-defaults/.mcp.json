{
  "supabase-prod": {
    "type": "http",
    "url": "https://mcp.supabase.com/mcp?project_ref=nwhtkmaujbrhwjbesixt",
    "headers": {
      "Authorization": "Bearer ${SUPABASE_ACCESS_TOKEN}"
    }
  },
  "supabase-dev": {
    "type": "http",
    "url": "https://mcp.supabase.com/mcp?project_ref=qbdyiyoaleuppddcsaxk",
    "headers": {
      "Authorization": "Bearer ${SUPABASE_ACCESS_TOKEN}"
    }
  },
  "horison-dev": {
    "type": "http",
    "url": "${DEV_HORISON_MCP_URL:-http://localhost:8010/mcp}"
  },
  "horison-prod": {
    "type": "http",
    "url": "https://mcp.horison.ai/mcp"
  },
  "neo4j-prod": {
    "command": "uvx",
    "args": [
      "--with",
      "fastmcp>=2,<2.14",
      "mcp-neo4j-cypher@0.5.2",
      "--transport",
      "stdio"
    ],
    "env": {
      "NEO4J_URI": "${PROD_NEO4J_URI}",
      "NEO4J_USERNAME": "${PROD_NEO4J_USERNAME}",
      "NEO4J_PASSWORD": "${PROD_NEO4J_PASSWORD}",
      "NEO4J_DATABASE": "${PROD_NEO4J_DATABASE}"
    }
  },
  "neo4j-dev": {
    "command": "uvx",
    "args": [
      "--quiet",
      "--with",
      "fastmcp>=2,<2.14",
      "mcp-neo4j-cypher@0.5.2",
      "--transport",
      "stdio"
    ],
    "env": {
      "NEO4J_URI": "${DEV_NEO4J_URI}",
      "NEO4J_USERNAME": "${DEV_NEO4J_USERNAME}",
      "NEO4J_PASSWORD": "${DEV_NEO4J_PASSWORD}",
      "NEO4J_DATABASE": "${DEV_NEO4J_DATABASE}"
    }
  },
  "neo4j-ta": {
    "command": "uv",
    "args": [
      "tool",
      "run",
      "--with",
      "fastmcp>=2,<2.14",
      "mcp-neo4j-cypher@0.5.2",
      "--transport",
      "stdio"
    ],
    "env": {
      "NEO4J_URI": "${TA_NEO4J_URI}",
      "NEO4J_USERNAME": "${TA_NEO4J_USERNAME}",
      "NEO4J_PASSWORD": "${TA_NEO4J_PASSWORD}",
      "NEO4J_DATABASE": "${TA_NEO4J_DATABASE}"
    }
  },
  "langfuse": {
    "type": "http",
    "url": "https://langfuse.horison.ai/api/public/mcp",
    "headers": {
      "Authorization": "Basic ${LANGFUSE_MCP_AUTH}"
    }
  },
  "langfuse-docs": {
    "type": "http",
    "url": "https://langfuse.com/api/mcp"
  },
  "serena": {
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/oraios/serena",
      "serena",
      "start-mcp-server",
      "--context",
      "claude-code"
    ]
  },
  "context7": {
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp@latest"
    ]
  },
  "playwright": {
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest"
    ]
  },
  "memory": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-memory"
    ]
  }
}
